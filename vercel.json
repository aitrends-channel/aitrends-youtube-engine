{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://app.heclus.io/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "aitrends-youtube-engine.vercel.app" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/worker-keepalive",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/finish-images",
      "schedule": "*/5 * * * *"
    }
  ]
}
